# Copiá este archivo a .env y ajustá los valores.
# Postgres (Docker). DATABASE_URL tiene que coincidir con estos valores.
POSTGRES_USER=manten
POSTGRES_PASSWORD=manten
POSTGRES_DB=manten_limpio
POSTGRES_PORT=5432
DATABASE_URL=postgres://manten:manten@localhost:5432/manten_limpio

# Firma de la cookie de sesión. Generá uno largo: openssl rand -base64 32
SESSION_SECRET=cambiame-por-un-secreto-largo-de-al-menos-32-caracteres

# Primer administrador (lo crea `npm run db:seed`; no se vuelve a crear si ya existe).
ADMIN_EMAIL=admin@mantenlimpio.local
ADMIN_PASSWORD=cambiame123
